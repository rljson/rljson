{
  // The package name, as declared in pubspec.yaml / package.json.
  "name": "@rljson/rljson",

  // 1-2 sentence summary about this repo.
  "summary": "Layer 0 of Rljson: the data format and its types. Tables (components, layers, cakes, sliceIds, trees, edits, insertHistory), TableCfg, Route, refs, validation, examples; sync wire types (ConnectorPayload incl. stamp/src, AckPayload, GapFill, SyncConfig, ClientId, RefStamp).",

  // 1-3 bullet points: the problem space.
  "domain": [
    "content-addressed relational data as JSON: table types, configs, routes, refs",
    "wire contract of the sync protocol between connectors and hubs",
    "no @rljson dependencies besides hash/json: everything else builds on it"
  ],

  // The repos this one depends on and the repos depending on it.
  // Keep the reason or the API behind each entry, not just the name.
  "interfaces": {
    // "<repo-a>": "why / API"
    "uses": {
      "hash": "hip/hsh to hash rows and tables",
      "json": "Json types"
    },

    // "<repo-b>": "why / API"
    "usedBy": {
      "io": "Rljson, TableCfg, ContentType for every Io",
      "db": "routes, table types, Connector wire types (ConnectorPayload, SyncConfig)",
      "server": "ConnectorPayload (src set by the hub), syncEvents, RefStamp",
      "fs-agent": "tree and edit types, routes",
      "mongo-agent": "table types, routes"
    }
  }
}
